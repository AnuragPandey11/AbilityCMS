# scripts/dev-up.sh's own bookkeeping: per-process logs and the PID file it
# tracks them by. Regenerated every run; never meant to be committed.
.dev-run/

# Terraform: downloaded providers, local records and saved plans never go in git.
# The provider lock file (deploy/terraform/.terraform.lock.hcl) does.
deploy/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
