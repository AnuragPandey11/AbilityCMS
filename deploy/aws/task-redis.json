{
  "family": "solarcms-redis",
  "networkMode": "host",
  "requiresCompatibilities": ["EC2"],
  "runtimePlatform": {"cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX"},
  "executionRoleArn": "arn:aws:iam::556935884877:role/solarcms-task-execution",
  "volumes": [{"name": "redis-data", "host": {"sourcePath": "/var/lib/solarcms/redis"}}],
  "containerDefinitions": [
    {
      "name": "redis",
      "image": "redis:7.4-alpine",
      "essential": true,
      "memoryReservation": 512,
      "command": ["redis-server", "--bind", "127.0.0.1", "--port", "6379", "--appendonly", "yes"],
      "mountPoints": [{"sourceVolume": "redis-data", "containerPath": "/data"}],
      "restartPolicy": {"enabled": true, "restartAttemptPeriod": 60},
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {"awslogs-group": "/solarcms/app", "awslogs-region": "ap-south-1", "awslogs-stream-prefix": "redis"}
      }
    }
  ]
}
