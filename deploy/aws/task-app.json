{
  "family": "solarcms-app",
  "networkMode": "host",
  "requiresCompatibilities": ["EC2"],
  "runtimePlatform": {"cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX"},
  "executionRoleArn": "arn:aws:iam::556935884877:role/solarcms-task-execution",
  "taskRoleArn": "arn:aws:iam::556935884877:role/solarcms-task",
  "containerDefinitions": [
    {
      "name": "api",
      "command": ["api"],
      "essential": true,
      "memoryReservation": 1024,
      "healthCheck": {
        "command": ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)"],
        "interval": 15, "timeout": 5, "retries": 3, "startPeriod": 30
      },
      "restartPolicy": {"enabled": true, "restartAttemptPeriod": 60}
    },
    {
      "name": "ingest",
      "command": ["ingest"],
      "essential": true,
      "memoryReservation": 512,
      "restartPolicy": {"enabled": true, "restartAttemptPeriod": 60}
    },
    {
      "name": "alarm",
      "command": ["alarm"],
      "essential": true,
      "memoryReservation": 256,
      "restartPolicy": {"enabled": true, "restartAttemptPeriod": 60}
    },
    {
      "name": "health_sweeper",
      "command": ["health_sweeper"],
      "essential": true,
      "memoryReservation": 256,
      "restartPolicy": {"enabled": true, "restartAttemptPeriod": 60}
    },
    {
      "name": "scheduler",
      "command": ["scheduler"],
      "essential": true,
      "memoryReservation": 1024,
      "restartPolicy": {"enabled": true, "restartAttemptPeriod": 60}
    }
  ]
}
