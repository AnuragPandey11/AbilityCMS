# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://solarcms:solarcms@localhost:5432/solarcms
DB_POOL_SIZE=10
# TimescaleDB is CONFIRMED for production (MASTER F-4). Set false only for a
# local Postgres without the extension: migrations then create plain tables and
# materialised views instead of hypertables and continuous aggregates.
TIMESCALE_ENABLED=true

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MQTT ─────────────────────────────────────────────────────────────────────
# Production: our own broker, TLS on 8883, with the ingest worker's credential.
MQTT_HOST=broker.example.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=solarcms-ingest
MQTT_PASSWORD=change-me
MQTT_CLIENT_ID=solarcms-ingest
MQTT_SUBSCRIBE_TOPICS=["scms/v1/#"]
MQTT_TOPIC_ROOT=scms/v1

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-value
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ── Ingestion tuning ─────────────────────────────────────────────────────────
INGEST_BATCH_MAX_ROWS=5000
INGEST_BATCH_MAX_SECONDS=2.0

# ── Storage / notifications ──────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=ap-south-1
SMTP_URL=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
