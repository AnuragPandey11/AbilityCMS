DATABASE_URL=postgresql+asyncpg://solarcms:solarcms@localhost:5432/solarcms
DB_POOL_SIZE=10
# TimescaleDB 2.30.0 installed against Postgres 18.6.
TIMESCALE_ENABLED=true

REDIS_URL=redis://localhost:6379/0

# The client's test broker. We are the SUBSCRIBER here; production reverses this
# (we operate the broker, they publish into it — MASTER F-17). Anonymous, plaintext.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TLS=false
MQTT_CLIENT_ID=solarcms-ingest-local
MQTT_SUBSCRIBE_TOPICS=["scms/v1/#","UNKNOWN/#"]
MQTT_TOPIC_ROOT=scms/v1

JWT_SECRET=dev-only-not-a-secret-replace-before-any-deployment
LOG_JSON=false
LOG_LEVEL=DEBUG
